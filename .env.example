# Copy to .env.local for local development. In Vercel, set both public keys
# separately for Preview and Production on BOTH applications.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
APP_MODE=public
# Public website: public. Separate admin website: admin.
# Migration operations only; never needed by the deployed application.
DATABASE_URL=
# Local review preview ONLY. Ignored on Vercel; unpublished data is never served there.
LOCAL_REFERENCE_PREVIEW=false
